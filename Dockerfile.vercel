FROM node:22-bookworm-slim

WORKDIR /app

# yt-dlp executes through python3. The Vercel Container includes it at build
# time, unlike the previous Node serverless function.
RUN apt-get update \
  && apt-get install -y --no-install-recommends python3 ca-certificates \
  && rm -rf /var/lib/apt/lists/*

COPY apps/openfy-api/package.json apps/openfy-api/package-lock.json ./
RUN npm ci

COPY apps/openfy-api/ ./
# @distube/ytdl-core uses Node's Undici APIs. Running Next through Bun in a
# Linux container makes its cookie interceptor fail during route collection.
RUN node node_modules/next/dist/bin/next build

ENV NODE_ENV=production
ENV PORT=3000
EXPOSE 3000

CMD ["sh", "-c", "node node_modules/next/dist/bin/next start -H 0.0.0.0 -p ${PORT:-3000}"]
