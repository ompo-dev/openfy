FROM oven/bun:1.3.14-debian

WORKDIR /app

# yt-dlp executes through python3. The Vercel Container includes it at build
# time, unlike the previous Node serverless function.
RUN apt-get update \
  && apt-get install -y --no-install-recommends python3 ca-certificates \
  && rm -rf /var/lib/apt/lists/*

COPY apps/openfy-api/package.json apps/openfy-api/bun.lock ./
RUN bun install --frozen-lockfile

COPY apps/openfy-api/ ./
RUN bun run build

ENV NODE_ENV=production
ENV PORT=3000
EXPOSE 3000

CMD ["sh", "-c", "bunx next start -H 0.0.0.0 -p ${PORT:-3000}"]
