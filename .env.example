# This value is embedded in the Web, iOS and Android app bundles. Never put a
# secret in an EXPO_PUBLIC_ variable.
EXPO_PUBLIC_MUSIC_SERVER_URL=https://your-openfy-api.vercel.app

# Spotify client ID is public and only needed for user login. Never put its
# client secret in Expo/EAS variables: it belongs only on the Openfy API.
EXPO_PUBLIC_SPOTIFY_CLIENT_ID=
