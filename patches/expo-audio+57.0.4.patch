+@UnstableApi
+class OpenfyChannelProcessor : BaseAudioProcessor() {
+  @Volatile var mono = false
+  @Volatile private var configuration = doubleArrayOf(1.0, 0.0)
+  private var applied: DoubleArray? = null
+  private var coefficients = emptyArray<DoubleArray>()
+  private var history = emptyArray<Array<DoubleArray>>()
+  private var frame = DoubleArray(0)
+
+  fun setEqualizer(packet: DoubleArray) {
+    require(packet.size in 2..30 && (packet.size - 2) % 4 == 0 && packet.all { it.isFinite() })
+    require(packet[0] in 0.0..1.0 && packet[1] in -1.0..1.0)
+    for (i in 2 until packet.size step 4) {
+      require(packet[i] in 20.0..20000.0 && packet[i+1] in -12.0..12.0 &&
+        packet[i+2] in 0.1..4.0 && packet[i+3] in 0.0..2.0)
+    }
+    configuration = packet.copyOf()
+  }
+
+  override fun onConfigure(input: AudioFormat): AudioFormat {
+    if (input.encoding != C.ENCODING_PCM_16BIT && input.encoding != C.ENCODING_PCM_FLOAT) throw UnhandledAudioFormatException(input)
+    frame = DoubleArray(input.channelCount)
+    applied = null
+    // Keep the processor active in stereo too: live mode changes need no seek/flush.
+    return input
+  }
+
+  override fun queueInput(input: ByteBuffer) {
+    val packet = configuration
+    if (applied !== packet) {
+      coefficients = Array((packet.size - 2) / 4) { band -> coefficients(packet, 2 + band * 4, inputAudioFormat.sampleRate.toDouble()) }
+      history = Array(inputAudioFormat.channelCount) { Array(coefficients.size) { DoubleArray(2) } }
+      applied = packet
+    }
+    val output = replaceOutputBuffer(input.remaining())
+    if (!mono && coefficients.isEmpty() && packet[1] == 0.0) {
+      output.put(input)
+    } else {
+      val channels = inputAudioFormat.channelCount
+      val floating = inputAudioFormat.encoding == C.ENCODING_PCM_FLOAT
+      while (input.remaining() >= inputAudioFormat.bytesPerFrame) {
+        var sum = 0.0
+        for (channel in 0 until channels) {
+          frame[channel] = if (floating) input.float.toDouble() else input.short / 32768.0
+          sum += frame[channel]
+        }
+        for (channel in 0 until channels) {
+          var value = (if (mono) sum / channels else frame[channel]) * packet[0]
+          for (band in coefficients.indices) {
+            val c = coefficients[band]; val s = history[channel][band]
+            val next = c[0] * value + s[0]
+            s[0] = c[1] * value - c[3] * next + s[1]; s[1] = c[2] * value - c[4] * next
+            value = next
+          }
+          if (channel == 0 && packet[1] > 0) value *= 1 - packet[1]
+          if (channel == 1 && packet[1] < 0) value *= 1 + packet[1]
+          if (floating) output.putFloat(value.coerceIn(-1.0, 1.0).toFloat())
+          else output.putShort((value * 32768).toInt().coerceIn(-32768, 32767).toShort())
+        }
+      }
+    }
+    output.flip()
+  }
+
+  override fun onFlush() { applied = null }
+
+  // Standard RBJ coefficients, independent of catalog and playback resolution.
+  private fun coefficients(p: DoubleArray, i: Int, rate: Double): DoubleArray {
+    val a = 10.0.pow(p[i+1] / 40)
+    val omega = 2 * PI * min(p[i], rate * 0.45) / rate
+    val c = cos(omega); val s = sin(omega); val alpha = s / (2 * p[i+2]); val beta = s * sqrt(2*a)
+    val v = when (p[i+3].toInt()) {
+      1 -> doubleArrayOf(a*((a+1)-(a-1)*c+beta), 2*a*((a-1)-(a+1)*c), a*((a+1)-(a-1)*c-beta),
+        (a+1)+(a-1)*c+beta, -2*((a-1)+(a+1)*c), (a+1)+(a-1)*c-beta)
+      2 -> doubleArrayOf(a*((a+1)+(a-1)*c+beta), -2*a*((a-1)+(a+1)*c), a*((a+1)+(a-1)*c-beta),
+        (a+1)-(a-1)*c+beta, 2*((a-1)-(a+1)*c), (a+1)-(a-1)*c-beta)
+      else -> doubleArrayOf(1+alpha*a, -2*c, 1-alpha*a, 1+alpha/a, -2*c, 1-alpha/a)
+    }
+    return doubleArrayOf(v[0]/v[3], v[1]/v[3], v[2]/v[3], v[4]/v[3], v[5]/v[3])
+  }
+}
+
+@UnstableApi
+class OpenfyAudioRenderers(context: Context, private val channels: OpenfyChannelProcessor) : DefaultRenderersFactory(context) {
+  override fun buildAudioSink(context: Context, enableFloatOutput: Boolean, enableAudioOutputPlaybackParams: Boolean): AudioSink {
+    return DefaultAudioSink.Builder(context)
+      .setEnableFloatOutput(false)
+      .setEnableAudioOutputPlaybackParameters(enableAudioOutputPlaybackParams)
+      .setAudioProcessors(arrayOf(channels))
+      .build()
+  }
+}
