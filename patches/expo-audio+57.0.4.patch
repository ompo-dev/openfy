--- /dev/null
+++ b/node_modules/expo-audio/ios/BackgroundPlaybackGate.swift
@@ -0,0 +1,14 @@
+// Openfy: progress-only updates need no JS or Now Playing work while hidden.
+struct BackgroundPlaybackGate {
+  private var lastSignature: String?
+
+  mutating func shouldPublish(isBackground: Bool, signature: String) -> Bool {
+    guard isBackground else {
+      lastSignature = nil
+      return true
+    }
+    guard lastSignature != signature else { return false }
+    lastSignature = signature
+    return true
+  }
+}
