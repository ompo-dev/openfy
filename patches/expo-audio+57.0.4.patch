+package expo.modules.audio
+
+import android.content.Context
+import androidx.media3.common.audio.AudioMixingUtil
+import androidx.media3.common.audio.AudioProcessor.AudioFormat
+import androidx.media3.common.audio.AudioProcessor.UnhandledAudioFormatException
+import androidx.media3.common.audio.BaseAudioProcessor
+import androidx.media3.common.audio.ChannelMixingMatrix
+import androidx.media3.common.util.UnstableApi
+import androidx.media3.exoplayer.DefaultRenderersFactory
+import androidx.media3.exoplayer.audio.AudioSink
+import androidx.media3.exoplayer.audio.DefaultAudioSink
+import java.nio.ByteBuffer
+
+@UnstableApi
+class OpenfyChannelProcessor : BaseAudioProcessor() {
+  @Volatile var mono = false
+  private var monoMatrix = ChannelMixingMatrix(2, 2, floatArrayOf(0.5f, 0.5f, 0.5f, 0.5f))
+
+  override fun onConfigure(input: AudioFormat): AudioFormat {
+    if (!AudioMixingUtil.canMix(input)) throw UnhandledAudioFormatException(input)
+    val channels = input.channelCount
+    monoMatrix = ChannelMixingMatrix(channels, channels, FloatArray(channels * channels) { 1f / channels })
+    // Keep the processor active in stereo too: live mode changes need no seek/flush.
+    return input
+  }
+
+  override fun queueInput(input: ByteBuffer) {
+    val output = replaceOutputBuffer(input.remaining())
+    if (mono && inputAudioFormat.channelCount > 1) {
+      AudioMixingUtil.mix(input, inputAudioFormat, output, outputAudioFormat,
+        monoMatrix, input.remaining() / inputAudioFormat.bytesPerFrame, false, true)
+    } else {
+      output.put(input)
+    }
+    output.flip()
+  }
+}
+
+@UnstableApi
+class OpenfyAudioRenderers(context: Context, private val channels: OpenfyChannelProcessor) : DefaultRenderersFactory(context) {
+  override fun buildAudioSink(context: Context, enableFloatOutput: Boolean, enableAudioOutputPlaybackParams: Boolean): AudioSink {
+    return DefaultAudioSink.Builder(context)
+      .setEnableFloatOutput(false)
+      .setEnableAudioOutputPlaybackParameters(enableAudioOutputPlaybackParams)
+      .setAudioProcessors(arrayOf(channels))
+      .build()
+  }
+}
