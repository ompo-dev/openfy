+#ifndef OPENFY_EQUALIZER_H
+#define OPENFY_EQUALIZER_H
+#include <math.h>
+#include <string.h>
+
+#define OPENFY_EQ_BANDS 7
+#define OPENFY_EQ_CHANNELS 8
+#define OPENFY_EQ_PACKET (2 + OPENFY_EQ_BANDS * 4)
+
+typedef struct {
+  double coefficients[OPENFY_EQ_BANDS][5];
+  double state[OPENFY_EQ_CHANNELS][OPENFY_EQ_BANDS][2];
+  int count;
+  double preamp;
+  double balance;
+} OpenfyEqualizer;
+
+// RBJ peak/shelf equations: https://www.w3.org/TR/audio-eq-cookbook/.
+static inline void OpenfyEQConfigure(OpenfyEqualizer *eq, const double *packet, int length, double rate) {
+  memset(eq, 0, sizeof(*eq));
+  eq->preamp = packet[0];
+  eq->balance = packet[1];
+  eq->count = (length - 2) / 4;
+  for (int band = 0; band < eq->count; band++) {
+    const double *p = packet + 2 + band * 4;
+    double a = pow(10, p[1] / 40);
+    double omega = 6.283185307179586 * fmin(p[0], rate * 0.45) / rate;
+    double c = cos(omega), s = sin(omega), alpha = s / (2 * p[2]), beta = s * sqrt(2 * a);
+    double b0, b1, b2, a0, a1, a2;
+    if ((int)p[3] == 1) {
+      b0 = a * ((a+1)-(a-1)*c+beta); b1 = 2*a*((a-1)-(a+1)*c); b2 = a*((a+1)-(a-1)*c-beta);
