# Comma-separated browser origins allowed to call the API. Native iOS/Android
# requests do not need a CORS origin.
OPENFY_ALLOWED_ORIGINS=https://your-openfy-web.vercel.app

# Needed for Spotify home/search data. Keep both only in Vercel/engine env.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Optional: direct heavy legacy work to a separately hosted HTTPS engine.
# OPENFY_LEGACY_ENGINE_URL=https://your-openfy-engine.example.com

# Optional secret. Store it only in Vercel or a local untracked .env.local file.
# It must contain a Netscape-format YouTube cookie file encoded as Base64.
# YOUTUBE_COOKIES_BASE64=
