{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/components/atoms/AppText": ["./components/gym/AppText.tsx"],
      "@/components/atoms/GlassSurface": ["./components/native/GlassSurface"],
      "@/constants/theme": ["./components/gym/theme.ts"],
      "@/hooks/use-colors": ["./components/gym/useColors.ts"],
      "@/core/log": ["./utils/appLogger.ts"],
      "@/core/appModals": ["./components/gym/appModals.ts"],
      "@/i18n": ["./components/gym/i18n.ts"],
      "@/global.css": ["./components/gym/theme.css"],
      "@/*": ["./vendor/gym-notes/src/*"],
      "@assets/*": ["./assets/*"],
      "@api": ["./api/index.ts"],
      "@components": ["./components/index.ts"],
      "@config": ["./config/index.ts"],
      "@context": ["./context/index.ts"],
      "@data": ["./data/index.ts"],
      "@hooks": ["./hooks/index.ts"],
      "@models": ["./models/index.ts"],
      "@navigators": ["./navigators/index.ts"],
      "@screens": ["./screens/index.ts"],
      "@services": ["./services/index.ts"],
      "@utils": ["./utils/index.ts"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "@typings/index.d.ts",
    "@typings/global.d.ts",
    "expo-env.d.ts"
  ],
  "exclude": [
    "node_modules",
    "**/__tests__/**",
    "**/__mocks__/**",
    "**/*.test.ts",
    "**/*.test.tsx"
  ]
}
